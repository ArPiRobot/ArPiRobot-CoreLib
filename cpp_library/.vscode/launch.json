{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Launch Native",
            "program": "${workspaceFolder}/build/native/Debug/testrobot",
            "args": [],
            "env": {
                "LD_LIBRARY_PATH": "${workspaceFolder}/build/native/Debug:${env:LD_LIBRARY_PATH}"
            },
            "cwd": "${workspaceFolder}",
            "preRunCommands": [
                "b main"
            ]
        },
        {
            "type": "lldb-dap",
            "request": "attach",
            "name": "Attach Remote",
            "program": "${workspaceFolder}/build/${command:cmake.activeConfigurePresetName}/Debug/testrobot",
            "attachCommands": [
                "gdb-remote 192.168.10.1:2000",
                "b main"
            ]
        }
    ]
}